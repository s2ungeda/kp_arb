# kp-arb 설정(.env) — 비밀값 아님. 여기엔 config만 둔다.
# 키(appkey/appsecret/계좌번호/비번)는 keys.bat으로 Windows 자격증명관리자에 등록한다.
#
# [실행 모드] 보통 keys.bat의 '실행 모드'로 정한다(자격증명관리자).
#   여기서 강제하려면 아래 줄 맨 앞 # 를 지운다(.env가 자격증명관리자를 덮어씀).
#KP_MODE=live
#
# [세션 초기값] 장중에 코어를 시작/재시작하면 JIF '장시작'을 놓쳐 세션이 DEAD로 막혀
#   발주가 안 될 수 있다. 그때만 아래 줄 맨 앞 # 를 지우고 코어를 재시작한다.
#   끝나면 다시 #로 막는다 — 정규 운영(09:00 이전 시작)에서 열어두면 장마감·휴일에도
#   데드존 안전장치가 풀려 위험하다.
#KP_SESSION_INIT=regular
#
# [FX 노출 보고 자동 송신] 기본은 코어 시동과 함께 자동 송신(10초마다 #2로 전송).
#   테스트 등으로 자동 시작을 막으려면 아래 줄 맨 앞 # 를 지운다(코어가 일시정지로 시작,
#   'FX 노출 감시' 화면의 '재개'로 켤 수 있다). 운영 복귀 때 다시 #로 막는다.
#KP_FX_AUTO_SEND=0
#
# [LS 접근 방식 — xingAPI 전환, DESIGN-ls-xing.md] 기본 openapi(REST/WS). xing으로 바꾸려면
#   아래 KP_LS_API 줄을 열고, xingAPI 패키지 설치(C:\meme, reg.bat 관리자 실행, DevCenter로 Res
#   내려받기) + 키 등록 창에 LS_XING_ID / LS_XING_PW / LS_XING_CERT_PW 등록.
#   서버 주소는 DevCenter 로그인 창 값(실서버 api.ls-sec.co.kr, 포트 20001).
#KP_LS_API=xing
KP_XING_HOST=api.ls-sec.co.kr
#KP_XING_PORT=20001
#KP_XING_PATH=C:\meme
#
# [시세 원문 기록 — 임시 진단, DESIGN-ls-xing.md §8] 기본 켬: logs\probe\quote_trade_YYYYMMDD.jsonl에
#   호가·체결 TR 원문을 남긴다(5일 지나면 삭제). 끄려면 아래 줄 맨 앞 # 를 지운다.
#KP_PROBE_TRS=0
