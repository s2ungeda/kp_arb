# kp-arb 설정(.env) — 비밀값 아님. 여기엔 config만 둔다.
# 키(appkey/appsecret/계좌번호/비번)는 keys.bat으로 Windows 자격증명관리자에 등록한다.
#
# [실행 모드] 보통 keys.bat의 '실행 모드'로 정한다(자격증명관리자).
#   여기서 강제하려면 아래 줄 맨 앞 # 를 지운다(.env가 자격증명관리자를 덮어씀).
#KP_MODE=live
#
# [세션 초기값] 장중에 코어를 시작/재시작하면 JIF '장시작'을 놓쳐 세션이 DEAD로 막혀
#   발주가 안 될 수 있다. 그때만 아래 줄 맨 앞 # 를 지우고 코어를 재시작한다.
#   끝나면 다시 #로 막는다 — 정규 운영(09:00 이전 시작)에서 열어두면 장마감·휴일에도
#   데드존 안전장치가 풀려 위험하다.
#KP_SESSION_INIT=regular
